// ═════════════════════════════════════════════════════════════
//  调试器修复验证用例（短版）
//
//  按顺序做四步，每步的预期现象都写在下面了。
// ═════════════════════════════════════════════════════════════

PROGRAM Main
VAR
    i   : INT;
    sum : INT;
    avg : REAL;
END_VAR

    // 【第 1 步】把鼠标移到左侧断点边栏（行号左边那条窄带）
    //           预期：悬停浮出「点击切换断点」提示，并出现空心圈
    //           点击 → 实心红点；再点一下 → 消失（可反复点）
    sum := 0;

    // 【第 2 步】在下面的 FOR 那一行也点一个断点，然后按 F5
    //           关键：断点是先设的，之前不需要先开始调试
    FOR i := 1 TO 10 DO
        sum := sum + i;
    END_FOR

    // 【第 3 步】F5 之后应当先停在第 21 行（FOR 那一行）
    //           预期：① 该行整行出现高亮
    //                 ② 输出面板显示「已暂停 @ PC=... 行 21」
    //                 ③ 断点面板列出第 17 行和第 21 行
    avg := sum / 2.0;

    // 【第 4 步】按 F10 单步走，高亮应当逐行跟着移动
    //           按 F5 继续，程序跑完
    Print(sum);        // → 55
    Print(avg);        // → 1.4E-322  ← 这是已知缺陷⑥，见文末

    // 跑完后高亮应当消失，输出面板末尾是「程序正常停机」
    Print(0);          // → 0 （结束标记）
END_PROGRAM


// ═════════════════════════════════════════════════════════════
//  预期输出（按顺序，一行一个）
//
//    55
//    1.4E-322
//    0
//
//  注意：第二行不是 5。sum 是 INT、2.0 是 REAL，混合类型算术目前
//        会把结果错存成 INT，按 double 读就成这个垃圾值 —— 见缺陷⑥。
//        这里故意留着当⑥的最小复现，不影响断点验证。
//
//  ────────────────────────────────────────────────────────
//  已知缺陷
//    ① 字符串字面量 → 打出 nil
//    ② 结构体作函数形参 → 返回值错乱
//    ③ 带 VAR_OUTPUT 的功能块调用 → 后端崩溃
//    ④ CASE ... OF 区间分支 → 死循环
//    ⑤ ABS/SQRT 等 IEC 标准库函数 → 不可用
//    ⑥ INT 与 REAL 混合运算 → 结果标签错成 INT（本例第 29、34 行）
// ═════════════════════════════════════════════════════════════
