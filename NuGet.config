<?xml version="1.0" encoding="utf-8"?>
<!--
  仓库级 NuGet 源配置：只保留 nuget.org。

  为什么 `<clear />`：此前开发机在用户级 %APPDATA%\NuGet\NuGet.Config 里额外配了私有源
  XxyNuget，与中央包管理（Directory.Packages.props）同时存在时，每个项目都会报
  NU1507（多源未做源映射），且干净机器上没有该源就无法 restore。
  本仓库的全部依赖均来自 nuget.org，故在此清空继承来的源并只声明 nuget.org。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
