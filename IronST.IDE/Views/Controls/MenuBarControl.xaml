<UserControl
  x:Class="IronST.IDE.Views.Controls.MenuBarControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Menu>
    <MenuItem Header="_File">
      <MenuItem
        Command="{Binding NewFileCommand}"
        Header="_New File"
        InputGestureText="Ctrl+N" />
      <MenuItem
        Command="{Binding OpenFileCommand}"
        Header="_Open File..."
        InputGestureText="Ctrl+O" />
      <MenuItem
        Command="{Binding OpenFolderCommand}"
        Header="Open _Folder..." />
      <Separator />
      <MenuItem
        Command="{Binding NewProjectCommand}"
        Header="New _Project..."
        InputGestureText="Ctrl+Shift+N" />
      <MenuItem
        Command="{Binding OpenProjectCommand}"
        Header="Open Pro_ject..."
        InputGestureText="Ctrl+Shift+O" />
      <Separator />
      <MenuItem
        Command="{Binding SaveCommand}"
        Header="_Save"
        InputGestureText="Ctrl+S" />
      <MenuItem
        Command="{Binding SaveAllCommand}"
        Header="Save A_ll"
        InputGestureText="Ctrl+Shift+S" />
      <MenuItem Command="{Binding SaveAsCommand}" Header="Save _As..." />
      <Separator />
      <MenuItem Header="Recent _Files">
        <MenuItem Header="(none)" IsEnabled="True" />
      </MenuItem>
      <Separator />
      <MenuItem Command="{Binding ExitCommand}" Header="E_xit" />
    </MenuItem>
    <MenuItem Header="_Edit">
      <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" />
      <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" />
      <Separator />
      <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" />
      <MenuItem Header="_Copy" InputGestureText="Ctrl+C" />
      <MenuItem Header="_Paste" InputGestureText="Ctrl+V" />
      <Separator />
      <MenuItem
        Command="{Binding FormatDocumentCommand}"
        Header="Format _Document"
        InputGestureText="Ctrl+Shift+F" />
      <Separator />
      <MenuItem Header="Select _All" InputGestureText="Ctrl+A" />
    </MenuItem>
    <MenuItem Header="_View">
      <MenuItem
        Header="Solution _Explorer"
        IsCheckable="True"
        IsChecked="{Binding ShowSolutionExplorer}" />
      <MenuItem
        Header="_Properties / Watch"
        IsCheckable="True"
        IsChecked="{Binding ShowPropertiesPanel}" />
      <MenuItem
        Header="_Output Panel"
        IsCheckable="True"
        IsChecked="{Binding ShowBottomPanel}" />
      <Separator />
      <MenuItem Header="Theme">
        <MenuItem
          x:Name="LightThemeMenuItem"
          Click="LightTheme_Click"
          Header="☀️  Light" />
        <MenuItem
          x:Name="DarkThemeMenuItem"
          Click="DarkTheme_Click"
          Header="🌙  Dark" />
      </MenuItem>

    </MenuItem>
    <MenuItem Header="_Debug">
      <MenuItem
        Command="{Binding DebugToggleCommand}"
        Header="Start _Debugging"
        InputGestureText="F5" />
      <MenuItem
        Command="{Binding RunWithoutDebugCommand}"
        Header="Start _Without Debugging"
        InputGestureText="Ctrl+F5" />
      <MenuItem
        Command="{Binding StopDebugCommand}"
        Header="_Stop Debugging"
        InputGestureText="Shift+F5" />
      <Separator />
      <MenuItem
        Command="{Binding StepIntoCommand}"
        Header="Step _Into"
        InputGestureText="F11" />
      <MenuItem
        Command="{Binding StepOverCommand}"
        Header="Step _Over"
        InputGestureText="F10" />
      <MenuItem
        Command="{Binding StepOutCommand}"
        Header="Step O_ut"
        InputGestureText="Shift+F11" />
      <Separator />
      <MenuItem
        Command="{Binding ToggleBreakpointCommand}"
        Header="Toggle _Breakpoint"
        InputGestureText="F9" />
    </MenuItem>
    <MenuItem Header="_Project">
      <MenuItem
        Command="{Binding BuildProjectCommand}"
        Header="_Build Project"
        InputGestureText="Ctrl+Shift+B" />
      <MenuItem
        Command="{Binding RunProjectCommand}"
        Header="_Run Project"
        InputGestureText="Ctrl+F5" />
      <Separator />
      <MenuItem
        Command="{Binding AddNewItemCommand}"
        Header="_Add New Item..."
        InputGestureText="Ctrl+Shift+A" />
      <MenuItem
        Command="{Binding AddExistingItemCommand}"
        Header="Add _Existing Item..."
        InputGestureText="Shift+Alt+A" />
    </MenuItem>
    <MenuItem Header="_Help">
      <MenuItem Command="{Binding AboutCommand}" Header="_About IronST.IDE" />
    </MenuItem>
  </Menu>
</UserControl>