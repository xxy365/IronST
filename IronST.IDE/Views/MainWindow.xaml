<Window
  x:Class="IronST.IDE.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:IronST.IDE.Views.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:IronST.IDE.ViewModels"
  Title="IronST.IDE"
  Width="800"
  Height="500"
  MinWidth="800"
  MinHeight="400"
  d:Height="850"
  d:Width="1400"
  AllowDrop="True"
  Drop="Window_Drop"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">

  <Window.Resources>
    <ResourceDictionary>
      <vm:MainWindowViewModel x:Key="VM" />
    </ResourceDictionary>
  </Window.Resources>

  <Window.DataContext>
    <Binding Source="{StaticResource VM}" />
  </Window.DataContext>

  <Window.InputBindings>
    <KeyBinding
      Key="N"
      Command="{Binding NewFileCommand}"
      Modifiers="Ctrl" />
    <KeyBinding
      Key="O"
      Command="{Binding OpenFileCommand}"
      Modifiers="Ctrl" />
    <KeyBinding
      Key="S"
      Command="{Binding SaveCommand}"
      Modifiers="Ctrl" />
    <KeyBinding
      Key="S"
      Command="{Binding SaveAllCommand}"
      Modifiers="Ctrl+Shift" />
    <KeyBinding
      Key="N"
      Command="{Binding NewProjectCommand}"
      Modifiers="Ctrl+Shift" />
    <KeyBinding
      Key="O"
      Command="{Binding OpenProjectCommand}"
      Modifiers="Ctrl+Shift" />
    <KeyBinding
      Key="B"
      Command="{Binding BuildProjectCommand}"
      Modifiers="Ctrl+Shift" />
    <KeyBinding
      Key="A"
      Command="{Binding AddNewItemCommand}"
      Modifiers="Ctrl+Shift" />
    <KeyBinding
      Key="A"
      Command="{Binding AddExistingItemCommand}"
      Modifiers="Shift+Alt" />
    <KeyBinding
      Key="W"
      Command="{Binding CloseTabCommand}"
      Modifiers="Ctrl" />
    <KeyBinding
      Key="F"
      Command="{Binding FormatDocumentCommand}"
      Modifiers="Ctrl+Shift" />
    <KeyBinding Key="F5" Command="{Binding DebugToggleCommand}" />
    <KeyBinding
      Key="F5"
      Command="{Binding RunWithoutDebugCommand}"
      Modifiers="Ctrl" />
    <KeyBinding
      Key="F5"
      Command="{Binding StopDebugCommand}"
      Modifiers="Shift" />
    <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand}" />
    <KeyBinding Key="F10" Command="{Binding StepOverCommand}" />
    <KeyBinding Key="F11" Command="{Binding StepIntoCommand}" />
    <KeyBinding
      Key="F11"
      Command="{Binding StepOutCommand}"
      Modifiers="Shift" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="5" />
      <RowDefinition Height="200" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  菜单栏  -->
    <controls:MenuBarControl Grid.Row="0" />

    <!--  工具栏  -->
    <controls:ToolBarControl Grid.Row="1" />

    <!--  主编辑区（三列）  -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="200" />
      </Grid.ColumnDefinitions>

      <controls:SolutionExplorerControl Grid.Column="0" />
      <GridSplitter
        Grid.Column="1"
        Width="5"
        HorizontalAlignment="Stretch"
        Visibility="{Binding ShowSolutionExplorer, Converter={StaticResource BoolToVis}}" />
      <controls:EditorAreaControl Grid.Column="2" />
      <GridSplitter
        Grid.Column="3"
        Width="5"
        HorizontalAlignment="Stretch"
        Visibility="{Binding ShowPropertiesPanel, Converter={StaticResource BoolToVis}}" />
      <controls:PropertiesPanelControl Grid.Column="4" />
    </Grid>

    <!--  底部面板分隔条  -->
    <GridSplitter
      Grid.Row="3"
      Height="5"
      VerticalAlignment="Stretch"
      Visibility="{Binding ShowBottomPanel, Converter={StaticResource BoolToVis}}" />

    <!--  底部面板  -->
    <controls:BottomPanelControl Grid.Row="4" />

    <!--  状态栏  -->
    <controls:StatusBarControl Grid.Row="5" />
  </Grid>
</Window>