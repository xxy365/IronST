<Window
  x:Class="StEditor.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:IronST.StEditor;assembly=IronST.StEditor"
  Title="ST Code Editor"
  Width="1000"
  Height="700"
  Background="#1e1e2e">

  <Grid>
    <!--  ══════ 工具栏（应用层，非控件层） ══════  -->
    <DockPanel>
      <ToolBar Background="#181825" DockPanel.Dock="Top">
        <Button
          Padding="8,4"
          Background="Transparent"
          BorderThickness="0"
          Click="Open_Click"
          Content="打开"
          Foreground="#cdd6f4" />
        <Button
          Padding="8,4"
          Background="Transparent"
          BorderThickness="0"
          Click="Save_Click"
          Content="保存"
          Foreground="#cdd6f4" />
      </ToolBar>

      <!--  ══════ ST 编辑器控件 ══════  -->
      <controls:StEditorControl
        x:Name="Editor"
        EditorTheme="Light"
        BaseFontSize="14"
        ShowLineNumbers="True"
        ZoomLevel="100" />
    </DockPanel>
  </Grid>
</Window>
