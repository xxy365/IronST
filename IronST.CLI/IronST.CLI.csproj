<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 产物名 = 文档里的命令名；发布单文件后为 ironst(.exe) -->
    <AssemblyName>ironst</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IronST.BytecodeGen\IronST.BytecodeGen.csproj" />
    <ProjectReference Include="..\IronST.Common\IronST.Common.csproj" />
    <ProjectReference Include="..\IronST.Frontend\IronST.Frontend.csproj" />
    <ProjectReference Include="..\IronST.LLVMCodeGen\IronST.LLVMCodeGen.csproj" />
    <ProjectReference Include="..\IronST.Runtime\IronST.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="test.st">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
