<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 端到端链路：Frontend → IRGenerator → ByteCodeGenerator → VM -->
    <ProjectReference Include="..\IronST.Frontend\IronST.Frontend.csproj" />
    <ProjectReference Include="..\IronST.LLVMCodeGen\IronST.LLVMCodeGen.csproj" />
    <ProjectReference Include="..\IronST.BytecodeGen\IronST.BytecodeGen.csproj" />
    <ProjectReference Include="..\IronST.Runtime\IronST.Runtime.csproj" />
    <ProjectReference Include="..\IronST.Runtime.Shared\IronST.Runtime.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
