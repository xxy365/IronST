<UserControl
  x:Class="IronST.StEditor.StEditorControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  MinWidth="200"
  MinHeight="150"
  d:DesignHeight="500"
  d:DesignWidth="800"
  mc:Ignorable="d">

  <UserControl.Resources>
    <!--  深色主题（默认）  -->
    <SolidColorBrush x:Key="ControlBackground" Color="#1e1e2e" />
    <SolidColorBrush x:Key="EditorForeground" Color="#cdd6f4" />
    <SolidColorBrush x:Key="LineNumbersForeground" Color="#6c7086" />
    <SolidColorBrush x:Key="StatusBarBackground" Color="#181825" />
    <SolidColorBrush x:Key="StatusBarForeground" Color="#a6adc8" />
    <SolidColorBrush x:Key="SeparatorColor" Color="#313244" />
    <SolidColorBrush x:Key="StatsNormal" Color="#a6adc8" />
    <SolidColorBrush x:Key="StatsHighlight" Color="#f9e2af" />
  </UserControl.Resources>

  <Grid Background="{DynamicResource ControlBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <avalonedit:TextEditor
      x:Name="Editor"
      Grid.Row="0"
      Padding="10,5"
      Background="{DynamicResource ControlBackground}"
      FontFamily="Cascadia Code, Consolas"
      Foreground="{DynamicResource EditorForeground}"
      LineNumbersForeground="{DynamicResource LineNumbersForeground}"
      PreviewMouseWheel="Editor_PreviewMouseWheel"
      ShowLineNumbers="{Binding ShowLineNumbers, RelativeSource={RelativeSource AncestorType=UserControl}}"
      SyntaxHighlighting="None"
      WordWrap="False" />

    <StatusBar
      Grid.Row="1"
      Padding="6,2"
      Background="{DynamicResource StatusBarBackground}"
      FontSize="12"
      Foreground="{DynamicResource StatusBarForeground}">
      <StatusBarItem>
        <TextBlock x:Name="CursorPositionText" Text="行 1, 列 1" />
      </StatusBarItem>
      <Separator Margin="8,2" Background="{DynamicResource SeparatorColor}" />
      <StatusBarItem>
        <TextBlock x:Name="StatsText" Text="0 个字符  0 行" />
      </StatusBarItem>
      <StatusBarItem Margin="0,0,4,0" HorizontalAlignment="Right">
        <TextBlock
          x:Name="ZoomText"
          Cursor="Hand"
          MouseLeftButtonDown="ZoomText_MouseLeftButtonDown"
          Text="100%"
          ToolTip="点击重置为 100%" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</UserControl>
